# ---- Web (public, baked into the static export; never put secrets here) ----
NEXT_PUBLIC_DATA_MODE=fixture          # fixture (P02 preview) | api
NEXT_PUBLIC_API_URL=                   # e.g. https://atlas-api.example.com (P04)
NEXT_PUBLIC_BASE_PATH=                 # /Atlas-studio for GitHub Pages, empty for Hostinger

# ---- API / worker (server only — P03) ----
DATABASE_URL=                          # Neon connection string (isolated project, not shared with Handy)
SESSION_SECRET=                        # 32+ random bytes
CORS_ORIGIN=                           # exact frontend origin(s), comma-separated
OWNER_EMAIL=                           # bootstrap owner (server env only)
OWNER_PASSWORD_HASH=                   # argon2/bcrypt hash, never plaintext
BLOB_STORE=local                       # local | s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DEMO_WORKSPACE_TTL_HOURS=24

# ---- Providers (leave empty to stay in local mode) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MONTHLY_BUDGET_USD=0          # 0 = live calls disabled
GEMINI_API_KEY=
