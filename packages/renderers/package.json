{
  "name": "@atlas/renderers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Structured, isomorphic export renderers (Markdown, CSV, JSON, PDF, PPTX). They read validated artifact content and never execute model-generated code or HTML.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlas/contracts": "workspace:*",
    "@atlas/domain": "workspace:*",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "eslint": "9.39.5",
    "typescript-eslint": "8.71.1",
    "@eslint/js": "9.39.5",
    "jszip": "3.10.1"
  }
}
